rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar se o usuário é admin
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Usuários: Membros podem ler seu próprio perfil, admins podem tudo
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Coleções Públicas: Leitura sem necessidade de auth
    match /events/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /videos/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /notices/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_updates/{document=**} {
      allow read: if true;
      allow write: if false; // Apenas Functions (Admin SDK) podem escrever
    }

    // Membros e Dados Restritos
    match /members/{memberId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Fallback: Bloqueia tudo o que não foi explicitamente permitido
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
